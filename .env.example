# UCM-20 — variables for `docker compose` (ollama and qdrant services).
# Copy to `.env` at the repository root. Backend configuration lives separately,
# in `server/.env` (see `server/.env.example`).

# The pinned model. Switching this to `qwen2.5:3b-instruct-q4_K_M` is the
# documented real fallback for 8 GB machines (UCM-22): configuration, never
# code. Must match the backend's LLM_MODEL, and its digest LLM_MODEL_DIGEST.
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# Residency window. Reloading the weights costs ~185 s (262 s cold parse vs 77 s warm).
OLLAMA_KEEP_ALIVE=30m

# Ports published on the host: during M2 the backend runs natively
# (`uv run uvicorn`) and reaches the containers through them.
OLLAMA_PORT=11434
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# GPU: uncomment to let Ollama use an NVIDIA card. The default compose file asks
# for no device on purpose — a reservation fails the whole `up` on a machine
# without one. `scripts/up.sh` (or `.\scripts\up.ps1`) makes this choice for you.
# Note Compose splits this on the platform's path separator; below is Windows.
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
