# UCM-20 — compose configuration. See README.md.

# Model
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_MODEL_DIGEST=845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
OLLAMA_KEEP_ALIVE=30m
LLM_NUM_CTX=8192

# Ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
OLLAMA_PORT=11434
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Backend
EXPLAIN_ENABLED=true
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# GPU — the launcher picks the overlay automatically (NVIDIA, then AMD, then CPU).
# Set COMPOSE_FILE only to pin one path for a bare `docker compose up`:
#   NVIDIA (CUDA):  docker-compose.yml;docker-compose.gpu.yml
#   AMD (ROCm, Linux only):  docker-compose.yml;docker-compose.rocm.yml
# For an AMD card whose ISA ROCm has no prebuilt kernel for, see HSA_OVERRIDE_GFX_VERSION
# in docker-compose.rocm.yml.
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
