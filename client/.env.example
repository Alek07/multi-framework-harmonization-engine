# Base de la API del motor. Sin valor, el cliente llama a `/api/v1` en su propio
# origen y el proxy de Vite lo reenvía al backend (vite.config.ts), de modo que
# el navegador habla con un solo origen y CORS no es una variable de la demo.
# En docker compose se apunta al servicio del backend.
VITE_API_BASE_URL=/api/v1

# Destino del proxy del servidor de desarrollo y de `vite preview`.
VITE_API_PROXY_TARGET=http://localhost:8000
