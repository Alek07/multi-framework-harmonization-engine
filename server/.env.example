PROJECT_NAME=server
ENVIRONMENT=local

# Bitácora append-only (UCM-11): SQLite es el único estado mutable del sistema.
DATABASE_URL=sqlite+aiosqlite:///./app.db
# El POC no publica revisión de Alembic: el esquema se crea desde los modelos al
# arrancar, para que `docker compose up` funcione en una máquina ajena.
CREATE_TABLES_ON_STARTUP=true

# Entradas versionadas del núcleo determinista (reproducibilidad)
CATALOG_PATH=data/catalog/catalog.v0.1.0.json
RULES_PATH=data/rules/precedence.v0.1.0.json
GATING_PATH=data/rules/gating.v0.1.0.json
PRIORITIZATION_PATH=data/rules/prioritization.v0.1.0.json
PROFILES_DIR=data/profiles

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
