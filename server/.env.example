# Backend configuration. See README.md.

PROJECT_NAME=server
ENVIRONMENT=local

# Audit log
DATABASE_URL=sqlite+aiosqlite:///./app.db
CREATE_TABLES_ON_STARTUP=true

# Versioned engine inputs
CATALOG_PATH=data/catalog/catalog.v0.6.0.json
RULES_PATH=data/rules/precedence.v0.2.0.json
GATING_PATH=data/rules/gating.v0.3.0.json
PRIORITIZATION_PATH=data/rules/prioritization.v0.2.0.json
PROFILES_DIR=data/profiles

# LLM
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_MODEL_DIGEST=845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TOP_P=1.0
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=180
LLM_KEEP_ALIVE=30m
LLM_WARM_ON_STARTUP=true

# Retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=catalog
QDRANT_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_CACHE_DIR=./.cache/models
EMBEDDING_NUM_THREADS=1
RAG_RETRIEVAL_DEPTH=50
RAG_TOP_K=10
RAG_CUT_TIE_EPSILON=0.01
RAG_MAX_K=16
RAG_FRAMEWORK_CAP=4
RAG_POPULATE_ON_STARTUP=true

# Explanations
EXPLAIN_ENABLED=true
EXPLAIN_TIMEOUT_SECONDS=600

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
