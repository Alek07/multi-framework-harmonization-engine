PROJECT_NAME=server
ENVIRONMENT=local

# Append-only audit log (UCM-11): SQLite is the only mutable state of the system.
DATABASE_URL=sqlite+aiosqlite:///./app.db
# The POC ships no Alembic revision: the schema is created from the models at
# startup, so `docker compose up` works on a foreign machine.
CREATE_TABLES_ON_STARTUP=true

# Versioned inputs of the deterministic core (reproducibility)
CATALOG_PATH=data/catalog/catalog.v0.1.0.json
RULES_PATH=data/rules/precedence.v0.1.0.json
GATING_PATH=data/rules/gating.v0.1.0.json
PRIORITIZATION_PATH=data/rules/prioritization.v0.1.0.json
PROFILES_DIR=data/profiles

# AI layer (M2). No value in this block is a tuning knob: they all govern what
# the LLM and the retriever produce, they are recorded in the audit log next to
# the catalog/rules versions, and they make the run reproducible (UCM-22).
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# Manifest digest of the model: the Ollama tag is mutable and pins nothing on
# its own. Real 8 GB fallback (qwen2.5:3b-instruct-q4_K_M):
#   357c53fb659c5076de1d65ccb0b397446227b71a42be9d1603d46168015c9e4b
LLM_MODEL_DIGEST=845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
# Greedy decoding with a fixed seed. These three are what Ollama's
# OpenAI-compatible endpoint actually carries; top_k and repeat_penalty are not
# request fields there and stay at the server defaults pinned by the Ollama image
# digest (see app/parse/agent.py).
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TOP_P=1.0
# Context window: applied server-side through OLLAMA_CONTEXT_LENGTH in the
# compose file, which reads this value. Ollama's default (4096) is too small for
# the parse prompt plus its JSON schema.
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=180

# Retrieval (UCM-13). The collection is named after the catalog version *and* a
# digest of the catalog the vectors were built from, so a catalog bump — or an
# edit made in place — is a different collection and never stale vectors.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=catalog
QDRANT_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
# ~1,1 GB pulled on first use. Gitignored and dockerignored: never tracked, never
# baked into an image.
EMBEDDING_CACHE_DIR=./.cache/models
# One thread: a multi-threaded reduction sums its partial results in whatever
# order the threads finish, so the vectors would not be identical from run to run
# even on the same machine.
EMBEDDING_NUM_THREADS=1
# How many *extra* candidates each query reserves per capability, on top of the
# catalog's own. Deliberately no score threshold: a threshold would discard
# candidates silently, which is the one thing the engine may not do.
RAG_TOP_K=10
# Populate Qdrant from the catalog at startup, in the background. Never fatal:
# the index is derived data and retrieval rebuilds it before its first query.
RAG_POPULATE_ON_STARTUP=true

# LLM explanations of the candidates (UCM-14). Strictly presentational: the prose
# never enters ranking, selection or coverage, so turning this off changes what
# the operator reads and nothing about the baseline. With it off, every candidate
# still carries the engine's own deterministic justification, marked `disabled`.
EXPLAIN_ENABLED=true
# One request explains every candidate of a capability (~12 paragraphs, ~900
# tokens) and the 7B decodes at ~3.5 tok/s on the reference CPU machine, so this
# batch needs minutes, not seconds. LLM_TIMEOUT_SECONDS is sized for a single
# parse and would cut it off mid-generation.
EXPLAIN_TIMEOUT_SECONDS=600

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
